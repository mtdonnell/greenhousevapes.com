{
  // Static-assets-only Worker, same shape as mtdonnell.com. No server-side
  // script — Cloudflare serves the repo root directly.
  "name": "greenhousevapes-com",
  "compatibility_date": "2026-08-25",

  // Keep the *.workers.dev preview URL alive. Declaring "routes" implicitly
  // disables it unless this is set — that silently 404'd the rsnamescape
  // preview during the first cutover attempt.
  "workers_dev": true,

  // A Route, not a Custom Domain. Cloudflare refuses to create a Custom Domain
  // over the DNS record that points the apex at Netlify (error 100117), and a
  // Route does not need to touch DNS: it sits in front of whatever that record
  // points at. Netlify stays configured as the origin but is never reached, so
  // rollback is "delete this route" rather than "restore a DNS record nobody
  // wrote down".
  //
  // The "/*" is load-bearing. A bare "greenhousevapes.com" pattern matches ONLY
  // the exact root path — "/about", and even "/?x=1", fall through to the
  // origin. That was the first cutover's failure mode: the homepage came from
  // the Worker while every other URL was still served by Netlify.
  "routes": [
    { "pattern": "greenhousevapes.com/*", "zone_name": "greenhousevapes.com" }
  ],

  "assets": {
    "directory": ".",

    // Netlify served /about from about.html and never used a trailing slash.
    // "drop-trailing-slash" reproduces that exactly: /about/ 301s to /about,
    // and /about serves about.html. Keeps every indexed URL shape intact.
    "html_handling": "drop-trailing-slash",

    // Default "none" returns a zero-length 404 body — a blank white page.
    "not_found_handling": "404-page"
  }
}
