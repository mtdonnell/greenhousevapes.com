# Files in this repo that must NOT be uploaded as public site assets.
#
# Cloudflare uploads the repo root as static assets. Without .git listed,
# /.git/config and /.git/index are reachable publicly — the classic exposed-
# repository misconfiguration. This bit mtdonnell.com; do not remove it.

.git
.gitignore

# wrangler writes .wrangler/cache/wrangler-account.json here, which contains the
# Cloudflare account id AND the account name - which is the account email. It
# was served publicly on the first deploy. Do not remove this line.
.wrangler
.assetsignore
wrangler.jsonc
README.md

# Build inputs and the archived Netlify deploy.
components/*.jsx
_netlify-original
.gitattributes

# Worker source and its dependencies - served by the runtime, never as files.
src
node_modules
package.json
package-lock.json
babel.config.json
